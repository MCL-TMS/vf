# VF 物流分析仪表板环境变量配置

# 应用配置
VITE_APP_TITLE="VF 物流分析仪表板"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="VF Corporation 物流数据分析平台"

# 开发配置
VITE_DEV_MODE=true
VITE_API_BASE_URL="http://localhost:3000"

# 数据配置 (目前使用Mock数据)
VITE_USE_MOCK_DATA=true
VITE_ENABLE_DEBUG_LOGS=true

# Maersk 品牌配置
VITE_BRAND_PRIMARY_COLOR="#42b0d5"
VITE_BRAND_NAME="Maersk"

# 功能开关
VITE_ENABLE_REAL_TIME_DATA=false
VITE_ENABLE_EXPORT_FEATURES=true
VITE_ENABLE_ADVANCED_FILTERS=true