# 服务器配置
NODE_ENV=development
PORT=3001
HOST=localhost

# Oracle数据库配置 - 请根据您的数据库情况填写
# 基本连接信息
ORACLE_USER=hr
ORACLE_PASSWORD=hr123
ORACLE_CONNECT_STRING=localhost:1521/XE

# 连接池配置（可选，使用默认值）
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# 常见的Oracle连接字符串格式示例：
# 本地Oracle XE数据库
# ORACLE_CONNECT_STRING=localhost:1521/XE

# 本地Oracle标准版数据库
# ORACLE_CONNECT_STRING=localhost:1521/ORCL

# 远程Oracle数据库
# ORACLE_CONNECT_STRING=192.168.1.100:1521/PROD

# 完整连接描述符格式（高级用法）
# ORACLE_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=XE)))

# 使用SID而不是SERVICE_NAME
# ORACLE_CONNECT_STRING=localhost:1521:XE

# CORS配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=info

# 安全配置（可选）
JWT_SECRET=your_jwt_secret_key_here
API_RATE_LIMIT=100

# Oracle Instant Client配置提示
# Windows: 确保PATH包含 C:\oracle\instantclient_21_8
# Linux: 确保LD_LIBRARY_PATH包含instantclient路径，并安装libaio1
# macOS: 确保DYLD_LIBRARY_PATH包含instantclient路径