# ==================== 环境配置 ====================
NODE_ENV=production

# ==================== 数据库配置 ====================
ORACLE_CONNECT_STRING=your-oracle-host:1521/your-service-name
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=replace-with-runtime-secret
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# ==================== 服务器配置 ====================
API_PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=https://cms-dashboard.ocf.fulfillment.maersk.com.cn

# ==================== JWT配置 ====================
JWT_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================== 防暴力破解配置 ====================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_TIME=900000
ATTEMPT_WINDOW=900000

# ==================== HTTPS配置 ====================
FORCE_HTTPS=true
HTTPS_REDIRECT=false
TRUST_PROXY=1
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ==================== 日志级别 ====================
LOG_LEVEL=info

# ==================== DIFY配置 ====================
VITE_DIFY_API_KEY=replace-with-dify-api-key
VITE_DIFY_API_URL=https://service-dify-devs.maersk-digital.net/v1

# ==================== Redis配置 ====================
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=prod:auth
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=900000

# ==================== MFA邮箱验证码配置 ====================
MFA_EMAIL_ENABLED=true
MFA_OTP_TTL_SECONDS=300
MFA_MAX_VERIFY_ATTEMPTS=5
MFA_OTP_PEPPER=replace-with-random-pepper

# ==================== SMTP发件配置 ====================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-pass
SMTP_FROM=no-reply@maersk.net
