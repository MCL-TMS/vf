# ==================== 环境配置 ====================
NODE_ENV=production

# ==================== 数据库配置 ====================
ORACLE_CONNECT_STRING=your-oracle-host:1521/your-service-name
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=replace-with-runtime-secret
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# ==================== JWT配置 ====================
# 生产环境必须使用随机生成的高强度密钥
JWT_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================== Redis配置 ====================
# 推荐用于 token 黑名单、登录失败计数等共享状态
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=prod:auth
# 如果不使用 REDIS_URL，也可以单独配置以下参数
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ==================== 防暴力破解配置 ====================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_TIME=900000
ATTEMPT_WINDOW=900000

# ==================== 全局API限流配置 ====================
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=900000

# ==================== HTTPS配置 ====================
# 生产环境默认建议开启 HTTPS 强制与 HSTS
FORCE_HTTPS=true
# 如果上游负载均衡/网关已经终止 TLS，可开启 308 重定向
HTTPS_REDIRECT=false
# 反向代理链路下必须按实际部署设置，例如 1 / true / loopback
TRUST_PROXY=1
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ==================== 服务器配置 ====================
API_PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=https://yourdomain.com

# ==================== MFA邮箱验证码配置 ====================
MFA_EMAIL_ENABLED=true
MFA_OTP_TTL_SECONDS=300
MFA_MAX_VERIFY_ATTEMPTS=5
MFA_OTP_PEPPER=replace-with-random-pepper

# SMTP发件配置
# 内网中继(无认证)示例：SMTP_PORT=25 + SMTP_SECURE=false + SMTP_USER/SMTP_PASS留空
SMTP_HOST=apmmail.maersk.net
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@maersk.net