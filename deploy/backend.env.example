NODE_ENV=production
HOST=127.0.0.1
API_PORT=3001
BACKEND_HTTPS_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.crt
SSL_KEY_PATH=/etc/nginx/ssl/cms-dashboard.ocf.fulfillment.maersk.com.cn.key
CORS_ORIGIN=https://stage-cms-dashboard.ocf.fulfillment.maersk.com.cn
ORACLE_USER=REPLACE_ON_SERVER
ORACLE_PASSWORD=REPLACE_ON_SERVER
ORACLE_CONNECT_STRING=REPLACE_ON_SERVER
JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=cms-dashboard:test