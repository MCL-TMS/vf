[Unit]
Description=CMS Dashboard Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/evelyn.zou/apps/cms-dashboard/backend
ExecStart=/usr/local/bin/node src/api-server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=development
EnvironmentFile=/etc/cms-dashboard/backend.env
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
