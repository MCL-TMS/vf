# ==================== 环境配置 ====================
NODE_ENV=production

# ==================== 数据库配置 ====================
ORACLE_CONNECT_STRING=ocmdb.ocf.fulfillment.maersk.com.cn:51521/PDB_CMS_PD
ORACLE_USER=USR_FLUX_HENGBOLI
ORACLE_PASSWORD=Flux3HB6Li9
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60



# ==================== JWT配置 ====================
# ⚠️ 生产环境必须使用强密钥！
JWT_SECRET=super-strong-production-secret-key-change-me-12345
JWT_REFRESH_SECRET=super-strong-refresh-secret-key-change-me-67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ==================== 防暴力破解配置 ====================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_TIME=900000
ATTEMPT_WINDOW=900000


# ==================== HTTPS配置 ====================
FORCE_HTTPS=true          # 生产环境强制HTTPS
HTTPS_REDIRECT=false      # 如果有自己的HTTPS服务器，设为true

# ==================== 服务器配置 ====================
API_PORT=3001
HOST=0.0.0.0              # 监听所有网络接口
CORS_ORIGIN=https://yourdomain.com

# ==================== 日志级别 ====================
LOG_LEVEL=warn            # 生产环境只记录警告和错误