<mxfile host="app.diagrams.net" modified="2026-04-14T00:00:00.000Z" agent="Mozilla/5.0" version="24.7.17">
  <diagram id="security-arch-updated" name="Security Architecture Updated">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Security Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=44;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="680" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Status: Implemented | Partially Implemented | Planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bfbfbf;fontSize=24;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="92" width="680" height="52" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="Layer 1: Password Verification&#xa;Status: Implemented (Legacy-compatible)&#xa;- Backend password verification in place&#xa;- Legacy plain/MD5 compatibility for migration&#xa;- No frontend MD5 dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="Layer 2: User Authentication&#xa;Status: Implemented&#xa;- DB user authentication&#xa;- Account status validation&#xa;- Token issuance on login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="220" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l3" value="Layer 3: JWT Token Mechanism&#xa;Status: Implemented&#xa;- JWT issued at login&#xa;- Middleware token validation&#xa;- Protected API access control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l4" value="Layer 4: Token Management&#xa;Status: Implemented (degraded mode possible)&#xa;- Access + refresh lifecycle in place&#xa;- Refresh token rotation implemented&#xa;- Revocation in Redis, memory fallback when Redis unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1430" y="220" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l5" value="Layer 5: Anti-Brute Force&#xa;Status: Implemented&#xa;- Failed-attempt threshold&#xa;- IP + username tracking&#xa;- Lockout with 429 response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l6" value="Layer 6: Brand Permission Control&#xa;Status: Partially Implemented&#xa;- Main query routes enforce backend claim-based scope&#xa;- Some upload/export flows still rely on request userBrands params&#xa;- Full convergence to claim-only model pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l7" value="Layer 7: Network Security&#xa;Status: Partially Implemented&#xa;- CORS configured&#xa;- Security headers enabled (Helmet)&#xa;- Production HTTPS enforcement hardening still needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="470" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l8" value="Layer 8: Session Security&#xa;Status: Partially Implemented&#xa;- Session restore in place (sessionStorage)&#xa;- Refresh path exists&#xa;- Idle timeout/absolute session lifetime pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1430" y="470" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l9" value="Layer 9: Secrets Management&#xa;Status: Partially Implemented&#xa;- Env-based secret loading is used&#xa;- Backend .env ignored in VCS (repo-level control)&#xa;- Centralized secret rotation/audit process not operationalized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="720" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l10" value="Layer 10: Audit and Monitoring&#xa;Status: Partially Implemented&#xa;- Basic runtime logs and Redis health/metrics available&#xa;- Alerting for suspicious behavior pending&#xa;- Centralized search/retention pipeline pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="720" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l11" value="Layer 11: Secure SDLC&#xa;Status: Planned&#xa;- SAST/dependency scanning gates&#xa;- Secret scanning in CI/CD&#xa;- Release approval traceability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1430" y="720" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Threat Coverage: Partially Mitigated (not full closure)&#xa;SQL Injection | XSS | CSRF (architecture-conditional) | Brute Force | Session Hijacking | MITM | Privilege Escalation | Replay Attacks&#xa;&#xa;Governance Loop: Prevention + Detection + Response + Recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1e5ea;strokeColor=#9aa3ad;fontSize=24;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="970" width="1840" height="95" as="geometry" />
        </mxCell>

